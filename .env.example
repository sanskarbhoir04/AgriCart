# =====================================================================
# AgriCart — example environment configuration.
# Copy this file to ".env" and fill in real values. ".env" itself must
# NEVER be committed to git.
# =====================================================================

# ── Database ──
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=agricart

# ── Groq (KrishiMitra widget chat) — https://console.groq.com/keys ──
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# ── data.gov.in Mandi price feed — https://data.gov.in (My Account → key) ──
MANDI_API_KEY=YOUR_DATA_GOV_IN_API_KEY_HERE

# ── Google Cloud Translate (optional) ──
GOOGLE_TRANSLATE_API_KEY=

# ── Google Sign-In — https://console.cloud.google.com/apis/credentials ──
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID_HERE

# ── Plant.id / Kindwise (leaf disease scanner) — http://admin.kindwise.com/ ──
PLANT_ID_API_KEY=

# ── Anthropic Claude (KrishiMitra chatbox, if used instead of Groq) ──
ANTHROPIC_API_KEY=

# ── Gmail SMTP (free email OTP delivery — PHPMailer) ──
# Use a Gmail App Password, NOT your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords (requires
# 2-Step Verification to be enabled on the Gmail account first).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME=AgriCart

SUPPORT_EMAIL=support@agricart.in
WEBSITE_URL=https://agricart.in

# ── App ──
APP_ENV=local
APP_URL=http://localhost/AgriCart
ALLOWED_ORIGINS=http://localhost,http://localhost/AgriCart

# Shown in the OTP email footer (includes/templates/otp_email.html).
# Update WEBSITE_URL to your real production domain before launch.
SUPPORT_EMAIL=support@agricart.in
WEBSITE_URL=https://agricart.in

# When APP_ENV=local and Gmail SMTP above is left blank/unset, the OTP
# is written to the PHP error log instead of being emailed — never
# shown on the page. Set OTP_DEV_LOG=true to include the actual 6-digit
# code in that log line (for local testing only). Always false/unset in
# production — the OTP must never be logged there.
OTP_DEV_LOG=false

# ── SMTP troubleshooting (LOCAL ONLY — both are ignored unless APP_ENV=local) ──
# MAIL_DEBUG=true prints the SMTP conversation (credentials redacted) to
# the PHP error log, so you can see exactly where sending fails.
MAIL_DEBUG=false
# MAIL_SMTP_INSECURE=true skips TLS certificate verification. Only use
# this if you've confirmed the failure is a certificate error caused by
# an outdated CA bundle on your local machine (common on older XAMPP/
# Windows installs) — never enable in production.
MAIL_SMTP_INSECURE=false
